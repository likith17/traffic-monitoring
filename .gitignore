# Virtual environments
.venv/
.vv/

# Python cache
__pycache__/
*.pyc

# Large local archives and personal documents (not part of the project)
YOLO V12 TRAFFIC CONGESTION ANALYSIS.zip
Termination_Report_*.tex

# LaTeX paper draft (kept local)
report/

# Local video clips for offline segment analysis (user-supplied)
videos/

# Streamlit local secrets / cache — keep the theme config and the secrets
# template tracked, but never the real secrets.toml
.streamlit/*
!.streamlit/config.toml
!.streamlit/secrets.toml.example

# OSMnx HTTP response cache (the GraphML in data/ is the real artifact)
cache/

# Phase 2 accumulating collector output: append-only, grows every run, so it
# would churn git. The dataset lives locally until a frozen snapshot is committed
# for fitting.
congestion_log.csv
congestion_logger_run.log

# Phase 3 per-run incident scan output (diagnostic, regenerated each run).
incident_reports.csv

# Perception audit output (diagnostic, regenerated each run).
perception_audit.csv

# Dynamic-conditions benchmark output (diagnostic, regenerated each run).
dynamic_benchmark.csv

# Local secrets (API keys): GEOAPIFY_KEY, ANTHROPIC_API_KEY, etc. Never commit.
.env

# LaTeX build artifacts
*.aux
*.log
*.out
*.synctex.gz
progress_report_*.pdf

# Candidate model weights under evaluation (not adopted yet)
yolov12m.pt
