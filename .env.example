# Copy this file to .env and fill in your keys. .env is gitignored, so your
# keys stay local and never get committed. The app loads .env automatically.

# Geoapify: Google-style address autocomplete across NYC (free tier, no billing).
# Get one at https://www.geoapify.com. Without it, search falls back to Nominatim.
GEOAPIFY_KEY=

# Vision-language model for incident detection and the "ask" features.
# Only needed for those; routing and congestion work without it.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Optional: Google Directions as the external comparison baseline (else OSRM).
GOOGLE_MAPS_API_KEY=
