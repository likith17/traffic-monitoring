# Copy this file to .env and fill in your keys. .env is gitignored, so your
# keys stay local and never get committed. The app loads .env automatically.

# Geoapify: Google-style address autocomplete across NYC (free tier, no billing).
# Get one at https://www.geoapify.com. Without it, search falls back to Nominatim.
GEOAPIFY_KEY=

# Vision-language model for incident detection (the "Scan incidents" button).
# OFF by default: routing, congestion scoring and the map all work without it,
# and with it off the app makes no outbound AI call and cannot run up a bill.
# The incident check then degrades to the honest score-only heuristic.
#
# To turn it on, set VLM_ENABLED=1 and pick ONE backend below.
VLM_ENABLED=0

# --- Option A (recommended, free, open-source): Ollama on the same host -------
# Install Ollama, run `ollama pull moondream` (or qwen2.5vl:3b for more accuracy),
# then uncomment these. The app talks to Ollama over its OpenAI-compatible API,
# so no code change and no paid key is needed. OPENAI_API_KEY can be any string.
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_VISION_MODEL=moondream

# --- Option B (paid, hosted): Anthropic or any OpenAI-compatible provider -----
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Optional: Google Directions as the external comparison baseline (else OSRM).
GOOGLE_MAPS_API_KEY=
