# Template for local secrets. Copy to secrets.toml and fill in your own keys:
#
#   Windows:      copy .streamlit\secrets.toml.example .streamlit\secrets.toml
#   Linux/macOS:  cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# secrets.toml is gitignored; this .example file is the committed template.
# Streamlit copies these values into environment variables at startup.
#
# All of it is OPTIONAL. With no keys the app still runs: routing, YOLO vision,
# the RL agent, the OSRM comparison and the benchmark all work, and route
# explanations fall back to a plain-text template.

# --- LLM for route explanations and the "Ask the city" chat tab ------------
# Both lines are needed together: without LLM_PROVIDER the code defaults to
# OpenAI and ignores the Anthropic key entirely.
LLM_PROVIDER = "anthropic"
ANTHROPIC_API_KEY = "sk-ant-..."

# Optional. Defaults to claude-haiku-4-5 (cheapest, fine for short routes).
# ANTHROPIC_MODEL = "claude-opus-4-8"

# --- Alternative: OpenAI-compatible provider ------------------------------
# LLM_PROVIDER = "openai"
# OPENAI_API_KEY = "sk-..."

# --- Optional: compare against real Google Directions ---------------------
# Without this the app uses the free public OSRM server (no key needed).
# GOOGLE_MAPS_API_KEY = "..."
